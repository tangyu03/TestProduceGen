          "trigger": "锁定",
          "direction": "lateral",
          "guard": "非内置管理员",
          "clause": "4.11.1(3)"
        },
        {
          "id": "T-USER-003",
          "from": "锁定",
          "to": "未锁定",
          "actor": "系统管理员",
          "trigger": "解锁",
          "direction": "backward",
          "note": "合法回退：解锁后恢复登录，SRS 4.11.1(4)",
