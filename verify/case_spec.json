{
  "spec_version": "1.1.1",
  "project": "CASC-STEC-PT007 项目评审系统",
  "domain_essence": "评审管理员组织专家按评审计划对项目分批评审打分，依据得分对项目定级，并依据项目阶段评价累计驱动研制机构升降级",
  "implicit_assumptions": [
    "项目必须先存在于系统中才能被选入评审（新增是选入的前置）",
    "评审计划的推进依赖其包含项目的状态协同，计划与项目是 1:N 且状态可异步",
    "机构评价的累计计数跨计划、跨阶段持续，不随单次归档清零",
    "超时自动流转依赖系统时钟，测试中必须可控",
    "专家打分数据的完整性（去极值需要足够普通专家数）是评价算法成立的前提"
  ],
  "state_machines": {
    "项目": {
      "dimension": "项目状态",
      "states": [
        "待选入",
        "已选入",
        "待评审",
        "评审中",
        "待归档",
        "已归档"
      ],
      "terminal_states": [
        "已归档"
      ],
      "orthogonal_dimensions": [
        "项目阶段(开题/验收)",
        "本阶段评价结果(优秀/良好/合格/不合格/差)"
      ],
      "phase_mapping": {
        "auto_derived": true,
        "derivation": "BFS from 待选入 over direction=forward edges only; backward edges never raise a state's phase",
        "reference": {
          "待选入": 0,
          "已选入": 1,
          "待评审": 2,
          "评审中": 3,
          "待归档": 4,
          "已归档": 5
        }
      },
      "transitions": [
        {
          "id": "T-PROJ-001",
          "from": "(初始)",
          "to": "待选入",
          "actor": "机构管理员",
          "trigger": "新增项目",
          "direction": "forward",
          "guard": "表单校验通过且建议书已上传",
          "clause": "4.6(1)a"
        },
        {
          "id": "T-PROJ-002",
          "from": "待选入",
          "to": "已选入",
          "actor": "评审管理员",
          "trigger": "项目选入",
          "direction": "forward",
          "guard": "本阶段评价结果不为差 且 (本阶段评价结果不为不合格 或 本阶段选入次数小于1)",
          "clause": "4.7.1"
        },
        {
          "id": "T-PROJ-003",
          "from": "已选入",
          "to": "待选入",
          "actor": "评审管理员",
          "trigger": "项目选出",
          "direction": "backward",
          "note": "合法回退：评审管理员主动选出，SRS 4.7.2",
          "clause": "4.7.2"
        },
        {
          "id": "T-PROJ-004",
          "from": "已选入",
          "to": "待评审",
          "actor": "评审管理员",
          "trigger": "纳入评审计划并保存",
          "direction": "forward",
          "indirect_via": "评审计划.建立",
          "clause": "4.5(2)"
        },
        {
          "id": "T-PROJ-005",
          "from": "待评审",
          "to": "评审中",
          "actor": "系统",
          "trigger": "计划启动（计划状态待启动变待评审）",
          "direction": "forward",
          "indirect_via": "评审计划.启动",
          "clause": "4.5(3)"
        },
        {
          "id": "T-PROJ-006",
          "from": "评审中",
          "to": "待归档",
          "actor": "系统",
          "trigger": "评审组全部专家提交打分",
          "direction": "forward",
          "guard": "全部专家打分状态为已提交",
          "note": "触发后自动进行项目评价",
          "clause": "4.5(4)"
        },
        {
          "id": "T-PROJ-007a",
          "from": "待归档",
          "to": "已选入",
          "actor": "系统",
          "trigger": "计划归档（计划转结束或超时结束）",
          "direction": "backward",
          "guard": "项目阶段为开题 且 评价结果为优秀或良好或合格",
          "note": "状态回退但阶段前进：阶段由开题变验收，SRS 4.5(5)a",
          "clause": "4.5(5)a"
        },
        {
          "id": "T-PROJ-007b",
          "from": "待归档",
          "to": "待选入",
          "actor": "系统",
          "trigger": "计划归档",
          "direction": "backward",
          "guard": "项目阶段为开题 且 评价结果为不合格或差",
          "note": "合法回退：阶段不变，SRS 4.5(5)b",
          "clause": "4.5(5)b"
        },
        {
          "id": "T-PROJ-007c",
          "from": "待归档",
          "to": "已归档",
          "actor": "系统",
          "trigger": "计划归档",
          "direction": "forward",
          "guard": "项目阶段为验收 且 评价结果为优秀或良好或合格",
          "clause": "4.5(5)c"
        },
        {
          "id": "T-PROJ-007d",
          "from": "待归档",
          "to": "待选入",
          "actor": "系统",
          "trigger": "计划归档",
          "direction": "backward",
          "guard": "项目阶段为验收 且 评价结果为不合格或差",
          "note": "合法回退：阶段不变，SRS 4.5(5)d",
          "clause": "4.5(5)d"
        },
        {
          "id": "T-PROJ-008",
          "from": "评审中",
          "to": "已选入",
          "actor": "系统",
          "trigger": "计划由已完成转结束或超时结束且项目仍处评审中",
          "direction": "backward",
          "note": "合法回退：回到计划建立前状态即已选入，SRS 4.5(5)e",
          "clause": "4.5(5)e"
        }
      ]
    },
    "评审计划": {
      "dimension": "计划状态",
      "states": [
        "已建立",
        "待启动",
        "待评审",
        "评审中",
        "暂停",
        "已完成",
        "结束",
        "超时结束",
        "取消结束"
      ],
      "terminal_states": [
        "结束",
        "超时结束",
        "取消结束"
      ],
      "orthogonal_dimensions": [
        "暂停前状态(待评审/评审中/已完成)",
        "计划类型(开题/验收)"
      ],
      "phase_mapping": {
        "auto_derived": true,
        "derivation": "BFS from 已建立 over forward edges; 取消结束 as terminal takes max phase",
        "reference": {
          "已建立": 0,
          "待启动": 1,
          "待评审": 2,
          "评审中": 3,
          "暂停": 3,
          "已完成": 4,
          "结束": 5,
          "超时结束": 5,
          "取消结束": 5
        }
      },
      "transitions": [
        {
          "id": "T-PLAN-001",
          "from": "(初始)",
          "to": "已建立",
          "actor": "评审管理员",
          "trigger": "建立评审计划",
          "direction": "forward",
          "guard": "选取1至5个已选入项目 且 评审组5或7或9人 且 有且仅1名组长 且 专家领域覆盖项目领域 且 回避规则通过",
          "clause": "4.8.1(1)(6), 4.8.2"
        },
        {
          "id": "T-PLAN-002",
          "from": "已建立",
          "to": "待启动",
          "actor": "评审管理员",
          "trigger": "下发",
          "direction": "forward",
          "clause": "4.8.4(1)"
        },
        {
          "id": "T-PLAN-003",
          "from": "已建立",
          "to": "待启动",
          "actor": "系统",
          "trigger": "下发超时自动转换",
          "direction": "forward",
          "time_control_required": true,
          "note": "超时跳级迁移，派生相位可能不递增属设计意图，SRS 4.8.4(2)",
          "clause": "4.8.4(2)"
        },
        {
          "id": "T-PLAN-004",
          "from": "已建立",
          "to": "取消结束",
          "actor": "评审管理员",
          "trigger": "取消",
          "direction": "forward",
          "note": "项目和专家状态返回计划建立前，SRS 4.8.3",
          "clause": "4.8.3"
        },
        {
          "id": "T-PLAN-005",
          "from": "待启动",
          "to": "待评审",
          "actor": "评审助理",
          "trigger": "启动",
          "direction": "forward",
          "clause": "4.8.5(1)"
        },
        {
          "id": "T-PLAN-006",
          "from": "待启动",
          "to": "待评审",
          "actor": "系统",
          "trigger": "启动超时自动转换",
          "direction": "forward",
          "time_control_required": true,
          "note": "超时跳级迁移，SRS 4.8.5(2)",
          "clause": "4.8.5(2)"
        },
        {
          "id": "T-PLAN-007",
          "from": "待评审",
          "to": "评审中",
          "actor": "评审专家",
          "trigger": "专家对项目打分保存",
          "direction": "forward",
          "clause": "4.8.6"
        },
        {
          "id": "T-PLAN-008",
          "from": "评审中",
          "to": "已完成",
          "actor": "系统",
          "trigger": "所有项目在评审时限内变为待归档",
          "direction": "forward",
          "note": "超时跳级迁移可能不递增，SRS 4.8.8(1)",
          "clause": "4.8.8(1)"
        },
        {
          "id": "T-PLAN-009",
          "from": "待评审",
          "to": "已完成",
          "actor": "系统",
          "trigger": "评审超时",
          "direction": "forward",
          "time_control_required": true,
          "note": "超时跳级迁移，SRS 4.8.8(2)",
          "clause": "4.8.8(2)"
        },
        {
          "id": "T-PLAN-010",
          "from": "评审中",
          "to": "已完成",
          "actor": "系统",
          "trigger": "评审超时",
          "direction": "forward",
          "time_control_required": true,
          "note": "超时跳级迁移，SRS 4.8.8(2)",
          "clause": "4.8.8(2)"
        },
        {
          "id": "T-PLAN-011",
          "from": "暂停",
          "to": "已完成",
          "actor": "系统",
          "trigger": "评审超时（暂停期间计时不停）",
          "direction": "forward",
          "time_control_required": true,
          "note": "超时跳级迁移，暂停期间计时不停，SRS 4.8.7(1)与4.8.8(2)",
          "clause": "4.8.7(1), 4.8.8(2)"
        },
        {
          "id": "T-PLAN-012",
          "from": "已完成",
          "to": "结束",
          "actor": "评审管理员",
          "trigger": "归档",
          "direction": "forward",
          "note": "评审助理亦可归档；触发项目归档分支与机构评价，SRS 4.8.9(1)(3)(4)",
          "clause": "4.8.9(1)(3)(4)"
        },
        {
          "id": "T-PLAN-013",
          "from": "已完成",
          "to": "超时结束",
          "actor": "系统",
          "trigger": "归档超时",
          "direction": "forward",
          "time_control_required": true,
          "note": "同样触发项目归档分支与机构评价，SRS 4.8.9(2)(3)(4)",
          "clause": "4.8.9(2)(3)(4)"
        },
        {
          "id": "T-PLAN-014a",
          "from": "待评审",
          "to": "暂停",
          "actor": "评审助理",
          "trigger": "暂停",
          "direction": "lateral",
          "note": "侧挂状态入口：暂停时专家不能评审、不能归档、计时不停，SRS 4.8.7(1)",
          "clause": "4.8.7(1)"
        },
        {
          "id": "T-PLAN-014b",
          "from": "评审中",
          "to": "暂停",
          "actor": "评审助理",
          "trigger": "暂停",
          "direction": "lateral",
          "note": "侧挂状态入口，SRS 4.8.7(1)",
          "clause": "4.8.7(1)"
        },
        {
          "id": "T-PLAN-014c",
          "from": "已完成",
          "to": "暂停",
          "actor": "评审助理",
          "trigger": "暂停",
          "direction": "lateral",
          "note": "侧挂状态入口，SRS 4.8.7(1)",
          "clause": "4.8.7(1)"
        },
        {
          "id": "T-PLAN-015",
          "from": "暂停",
          "to": "$pre_pause_state",
          "actor": "评审助理",
          "trigger": "重启",
          "direction": "backward",
          "note": "合法回退：状态返回暂停前状态（待评审/评审中/已完成），SRS 4.8.7(2)",
          "clause": "4.8.7(2)"
        }
      ]
    },
    "机构": {
      "dimension": "机构状态",
      "states": [
        "合格",
        "不合格",
        "试用"
      ],
      "terminal_states": [],
      "phase_mapping": {
        "auto_derived": true,
        "derivation": "BFS from 合格 over forward edges; 环状机forward边anomaly属设计意图",
        "reference": {
          "合格": 0,
          "不合格": 1,
          "试用": 2
        }
      },
      "transitions": [
        {
          "id": "T-ORG-001",
          "from": "(初始)",
          "to": "合格",
          "actor": "系统管理员",
          "trigger": "添加研制机构",
          "direction": "forward",
          "note": "机构建立后默认合格，SRS 4.11.3(1)",
          "clause": "4.11.3(1)"
        },
        {
          "id": "T-ORG-002",
          "from": "合格",
          "to": "不合格",
          "actor": "系统",
          "trigger": "计划归档时累计触发",
          "direction": "forward",
          "guard": "差累计达到3次及以上 或 (差累计达到1次及以上 且 不合格累计达到3次及以上) 或 不合格累计达到5次及以上",
          "indirect_via": "评审计划.归档",
          "clause": "4.9.7(1)"
        },
        {
          "id": "T-ORG-003",
          "from": "不合格",
          "to": "试用",
          "actor": "系统管理员",
          "trigger": "提为试用",
          "direction": "backward",
          "guard": "机构累计评级为不合格次数小于3",
          "note": "合法回退：恢复性提升，SRS 4.9.7(2)d",
          "clause": "4.9.7(2)d"
        },
        {
          "id": "T-ORG-004",
          "from": "试用",
          "to": "合格",
          "actor": "系统",
          "trigger": "计划归档时累计触发",
          "direction": "forward",
          "guard": "项目阶段评价结果为优累计达到10次及以上",
          "indirect_via": "评审计划.归档",
          "note": "环状机升级边，派生相位不递增属设计意图，SRS 4.9.7(3)a",
          "clause": "4.9.7(3)a"
        },
        {
          "id": "T-ORG-005a",
          "from": "试用",
          "to": "不合格",
          "actor": "系统",
          "trigger": "计划归档时累计触发",
          "direction": "forward",
          "guard": "差累计达到2次及以上",
          "indirect_via": "评审计划.归档",
          "note": "环状机降级边，SRS 4.9.7(3)b",
          "clause": "4.9.7(3)b"
        },
        {
          "id": "T-ORG-005b",
          "from": "试用",
          "to": "不合格",
          "actor": "系统",
          "trigger": "计划归档时累计触发",
          "direction": "forward",
          "guard": "差累计达到1次及以上 且 不合格累计达到2次及以上",
          "indirect_via": "评审计划.归档",
          "note": "环状机降级边，SRS 4.9.7(3)c",
          "clause": "4.9.7(3)c"
        },
        {
          "id": "T-ORG-005c",
          "from": "试用",
          "to": "不合格",
          "actor": "系统",
          "trigger": "计划归档时累计触发",
          "direction": "forward",
          "guard": "不合格累计达到4次及以上",
          "indirect_via": "评审计划.归档",
          "note": "环状机降级边，SRS 4.9.7(3)d",
          "clause": "4.9.7(3)d"
        },
        {
          "id": "T-ORG-005e",
          "from": "试用",
          "to": "不合格",
          "actor": "系统",
          "trigger": "升降条件同时满足时优先降级",
          "direction": "forward",
          "guard": "升合格条件与降不合格条件同时满足",
          "note": "优先级规则：同时满足时降为不合格；环状机降级边，SRS 4.9.7(3)e",
          "clause": "4.9.7(3)e"
        }
      ]
    },
    "打分": {
      "dimension": "打分状态",
      "states": [
        "未打分",
        "已保存",
        "已提交"
      ],
      "terminal_states": [
        "已提交"
      ],
      "phase_mapping": {
        "auto_derived": true,
        "derivation": "linear chain from 未打分",
        "reference": {
          "未打分": 0,
          "已保存": 1,
          "已提交": 2
        }
      },
      "transitions": [
        {
